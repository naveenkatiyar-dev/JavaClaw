{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BudgetBreachedNoNewSpend",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances", "ec2:StartInstances", "ec2:CreateVolume", "ec2:CreateNatGateway", "ec2:AllocateAddress",
        "rds:CreateDBInstance", "rds:StartDBInstance", "rds:CreateDBCluster", "rds:StartDBCluster",
        "lambda:CreateFunction", "lambda:UpdateFunctionConfiguration", "ecs:RunTask", "ecs:CreateService", "ecs:UpdateService",
        "bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream", "bedrock:Converse", "bedrock:ConverseStream",
        "apprunner:CreateService", "lightsail:Create*", "dynamodb:CreateTable", "s3:CreateBucket"
      ],
      "Resource": "*"
    }
  ]
}
